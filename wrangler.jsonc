{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intowild-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 不要加 html_handling: "none"：那会把「/ → index.html」一起关掉，首页直接 404。
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // 自定义域。前提：intowild.online 这个 zone 已经在同一个 Cloudflare 账号里且状态 Active。
  // 首次 deploy 会自动创建 CNAME 并签发证书；zone 没接好时 deploy 会报错，先把域名接进 Cloudflare。
  "routes": [
    { "pattern": "intowild.online", "custom_domain": true },
    { "pattern": "www.intowild.online", "custom_domain": true }
  ]
}
