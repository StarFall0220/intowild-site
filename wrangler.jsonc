{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intowild-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 不要加 html_handling: "none"：那会把「/ → index.html」一起关掉，首页直接 404。
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // 留言板（一条留言一行，只追加）。建库：wrangler d1 create intowild-guestbook
  // 建表：wrangler d1 execute intowild-guestbook --file=./schema.sql --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "intowild-guestbook",
      "database_id": "a4e47f56-2c4c-460d-a419-f16f12cd8df4"
    }
  ],

  "vars": {
    // 紧急开关：改成 "false" 并重新部署即可停止接收新留言
    "GUESTBOOK_OPEN": "true"
  },

  // 自定义域。前提：zone 已在同一个 Cloudflare 账号且 Active。
  // 绑定前先确认这些主机名没有既存的 A/CNAME，否则 deploy 会报 code 100117。
  "routes": [
    { "pattern": "intowild.online", "custom_domain": true },
    { "pattern": "www.intowild.online", "custom_domain": true },
    { "pattern": "activitymap.intowild.online", "custom_domain": true },
    { "pattern": "guestbook.intowild.online", "custom_domain": true }
  ]
}
